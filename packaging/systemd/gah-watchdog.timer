# Paired with gah-watchdog.service (issue #726). `gah update`/
# `scripts/install.sh` install this template but never enable or start it --
# opt in explicitly:
#   systemctl --user enable --now gah-watchdog.timer
[Unit]
Description=Run the Parasaur loop health check every ten minutes (alert-only)

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
