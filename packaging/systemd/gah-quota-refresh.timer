# gah-quota-refresh.timer
#
# Issue #761: runs gah-quota-refresh.service every 15 minutes so account-level
# quota observations are populated automatically, independent of whether any
# dispatch happens to succeed. The auto-refresh command applies its own
# per-source 14-minute throttle internally (#1331), so every tick refreshes each
# source and readings never pass the 30-minute routing freshness window.
#
# Install:
#   `gah update` installs and enables this timer. Manual install:
#   mkdir -p ~/.config/systemd/user
#   cp gah-quota-refresh.service gah-quota-refresh.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now gah-quota-refresh.timer
[Unit]
Description=Refresh Parasaur account-level quota every 15 minutes (issue #761)

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
