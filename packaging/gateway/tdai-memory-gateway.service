# tdai-memory-gateway.service
#
# Optional MemoryCore package template. Ordinary GAH installs do not ship it.
# The colocated installer renders its paths only when explicitly requested.
#
# Runs the TDAI (TencentDB Agent Memory) gateway as a user service: the
# shared memory backend GAH's apps/server manager-chat harness calls
# directly (POST /recall before each turn, /capture after), so context
# survives swapping which manager backend (Hermes/Codex/Claude) is running.
#
# PARASAUR_GATEWAY_MODE=colocated makes scripts/install.sh render this template
# with PARASAUR_GATEWAY_MEMORYCORE_PATH and the Node directory on PATH. Ordinary
# GAH installs skip it. For local overrides, use:
#   systemctl --user edit tdai-memory-gateway.service
#
# Config: <MemoryCore checkout>/tdai-gateway.local.yaml. A fresh install
# seeds this from the tracked tdai-gateway.standalone.yaml template
# (keyword recall, no model calls) if it doesn't already exist. Re-run
# the installer with PARASAUR_GATEWAY_PROVIDER=ollama or openai to add a model
# provider; see docs/OPERATIONS.md.
#
# Auth: TDAI_GATEWAY_API_KEY lives in ~/.config/gah/tdai-gateway.env
# (chmod 600), loaded via EnvironmentFile. TDAI_LLM_API_KEY and
# TDAI_EMBEDDING_API_KEY are optional and live there too when the
# configured model backend needs a key.
# TDAI_GATEWAY_API_KEY is required on every gateway route except GET
# /health. Bound to 127.0.0.1 by default -- see docs/OPERATIONS.md's
# network-exposure section (issue #879, `gah network-expose`) before
# widening that.

[Unit]
Description=TDAI (TencentDB Agent Memory) Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@MEMORYCORE@
Environment=HOME=%h
Environment="TDAI_GATEWAY_CONFIG=@MEMORYCORE@/tdai-gateway.local.yaml"
Environment="PATH=@NODE_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=%h/.config/gah/tdai-gateway.env
ExecStart="@NODE_DIR@/npx" tsx src/gateway/server.ts
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
