{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GAH",
  "version": "0.3.0",
  "identifier": "com.kh1ng.gah-worker",
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "local-settings",
          "description": "Bundled Settings page only; remote dashboards cannot operate this computer",
          "windows": [
            "dashboard"
          ],
          "permissions": [
            "core:default",
            "allow-desktop-settings",
            "allow-save-presence",
            "allow-connect-dashboard",
            "allow-open-central-settings",
            "allow-owner-credential-status",
            "allow-save-owner-credential",
            "allow-forget-owner-credential",
            "allow-node-role-status",
            "allow-set-node-role",
            "allow-worker-status",
            "allow-set-worker-running",
            "allow-repository-tools",
            "allow-setup-check",
            "allow-open-setup-terminal",
            "allow-set-factory-enabled",
            "allow-set-notifications-enabled",
            "allow-mistral-login-start",
            "allow-mistral-login-finish",
            "allow-credential-list",
            "allow-credential-save",
            "allow-credential-remove",
            "allow-credential-refresh",
            "allow-credential-instances",
            "allow-credential-bind",
            "allow-credential-add-instance",
            "allow-desktop-update-status",
            "allow-desktop-apply-update"
          ],
          "local": true
        },
        {
          "identifier": "remote-open-project",
          "description": "Configured central dashboards may resolve and open only local GAH checkout identifiers",
          "windows": [
            "dashboard"
          ],
          "permissions": [
            "allow-desktop-open-context",
            "allow-open-local-checkout"
          ],
          "remote": {
            "urls": [
              "http://*",
              "https://*"
            ]
          },
          "local": false
        },
        {
          "identifier": "remote-external-links",
          "description": "Configured central dashboards may open plain HTTP(S) provider URLs in the OS browser",
          "windows": [
            "dashboard"
          ],
          "permissions": [
            "allow-open-external-url"
          ],
          "remote": {
            "urls": [
              "http://*",
              "https://*"
            ]
          },
          "local": false
        }
      ]
    },
    "windows": []
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm exec vite -- --port 1420 --strictPort"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    }
  }
}
