#!/usr/bin/env node
// Fake `gah` binary for apps/server endpoint tests (issue #635). Replays
// recorded --json output from ./responses/*.json for the subcommands
// server.ts actually shells out to; never invokes anything real.
//
// Success: exits 0, writes the matching recorded response to stdout.
// Forced failure: set GAH_FIXTURE_FAIL=<name> (one of the names below) to
// make that one subcommand exit non-zero with a stderr message instead --
// this is how tests exercise the "CLI failure surfaces as an HTTP error,
// never healthy-looking empty data" invariant deterministically.
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const responsesDir = path.join(__dirname, 'responses');

function respond(name) {
  const failing = process.env.GAH_FIXTURE_FAIL;
  if (failing === name) {
    const code = Number.parseInt(process.env.GAH_FIXTURE_FAIL_CODE ?? '1', 10);
    const message = process.env.GAH_FIXTURE_FAIL_MESSAGE ?? `fixture: forced failure for '${name}'`;
    process.stderr.write(message + '\n');
    process.exit(code);
  }
  // Tests that need their own profile facts (e.g. the WP2 chat-session
  // tests pointing repo_id/local_path/worktree_base at a temp git repo) can
  // point GAH_FIXTURE_PROFILE_LIST at an arbitrary JSON file instead of
  // editing the recorded response.
  if (name === 'profile-list' && process.env.GAH_FIXTURE_PROFILE_LIST) {
    process.stdout.write(fs.readFileSync(process.env.GAH_FIXTURE_PROFILE_LIST, 'utf8'));
    process.exit(0);
  }
  // Tests that need their own ledger (e.g. the GitLab runs feed's mixed
  // GitHub/GitLab fixtures) point GAH_FIXTURE_REPORT at a report JSON whose
  // ledger_path selects their ledger file instead of the recorded response.
  if (name === 'report' && process.env.GAH_FIXTURE_REPORT) {
    process.stdout.write(fs.readFileSync(process.env.GAH_FIXTURE_REPORT, 'utf8'));
    process.exit(0);
  }
  const file = path.join(responsesDir, `${name}.json`);
  process.stdout.write(fs.readFileSync(file, 'utf8'));
  process.exit(0);
}

const args = process.argv.slice(2);
const [command, sub] = args;
if (process.env.GAH_FIXTURE_QUERY_LOG && (command === 'report' || (command === 'ledger' && sub === 'summary'))) {
  fs.appendFileSync(process.env.GAH_FIXTURE_QUERY_LOG, JSON.stringify(args) + '\n');
}

if (command === 'pm') {
  if (process.env.GAH_FIXTURE_PM_LOG) fs.appendFileSync(process.env.GAH_FIXTURE_PM_LOG, JSON.stringify(args) + '\n');
  const profile = args.find(value => value.startsWith('--profile='))?.slice('--profile='.length);
  const provider = profile === 'github-project' ? 'github' : profile === 'gitlab-project' ? 'gitlab' : null;
  if (!provider || !args.includes('--json') || args.some(value => value.startsWith('--plan='))) process.exit(2);
  const fixturePath = path.resolve(__dirname, '../../../../../packages/contracts/src/fixtures', `pm-plan-${provider}.json`);
  const plan = JSON.parse(fs.readFileSync(fixturePath, 'utf8'));
  let result = plan;
  if (sub === 'plans') result = {
    schema_version: 1, generated_at: plan.generated_at, profile, next_cursor: null, errors: [],
    plans: [{ id: plan.id, title: plan.artifact.plan.title, source_work_id: plan.source_work_id,
      ticket_count: plan.artifact.ticket_count, updated_at: plan.updated_at,
      publication_status: plan.publication.status, plan_fingerprint: plan.publication.plan_fingerprint }]
  };
  else if (!args.includes('--plan-id=plan-1')) process.exit(2);
  if (sub === 'publish') {
    const dryRun = args.includes('--dry-run');
    if (!dryRun && !args.includes(`--expected-fingerprint=${plan.publication.plan_fingerprint}`)) process.exit(2);
    result = { schema_version: 1, generated_at: plan.generated_at, dry_run: dryRun,
      success: dryRun, plan, output: dryRun ? ['would create child'] : [],
      error: dryRun ? null : 'Fixture provider stopped after the first child.' };
  } else if (!['plans', 'show'].includes(sub)) process.exit(2);
  process.stdout.write(JSON.stringify(result));
  process.exit(0);
} else if (command === 'route') {
  if (args.includes('--failure-backend')) {
    let input = ''; for await (const chunk of process.stdin) input += chunk;
    const kind = /not your usage limit/i.test(input) ? 'transient'
      : /usage limit|session limit|weekly limit|monthly limit|Individual quota reached|quota exhausted/i.test(input) ? 'hard'
      : /rate limit|429|overloaded/i.test(input) ? 'transient' : 'other';
    process.stdout.write(JSON.stringify({ kind, resetAt: kind === 'hard' ? Date.now() + 3600000 : null, retryAfterMs: 1 }));
  } else {
    const backends = JSON.parse(process.env.GAH_FIXTURE_QUOTA_ROUTES ?? '["codex"]');
    process.stdout.write(JSON.stringify(backends.map(backend => ({ identity: { runner_kind: backend, logical_backend: backend, backend_instance: `legacy:${backend}`, effective_model: null, quota_pool: null } }))));
  }
  process.exit(0);
} else if (command === 'status') {
  if (args.includes('--role')) {
    process.stdout.write(JSON.stringify({ role: 'central', central_url: null }));
    process.exit(0);
  }
  respond('status');
} else if (command === 'quota' && sub === 'snapshot') {
  respond('quota');
} else if (command === 'report') {
  // Mirror parse_since (src/ledger/summary.rs): only Nd / Nh are accepted.
  const since = args[args.indexOf('--since') + 1];
  if (args.includes('--since') && !/^\d+[dh]$/.test(since ?? '')) {
    process.stderr.write(`invalid --since value '${since}'; use forms like 7d or 24h\n`);
    process.exit(1);
  }
  respond(args.includes('--series') ? 'report-series' : 'report');
} else if (command === 'events') {
  respond('events');
} else if (command === 'ledger' && sub === 'summary') {
  respond('ledger-summary');
} else if (command === 'config' && sub === 'show') {
  respond('config-show');
} else if (command === 'profile' && sub === 'list') {
  respond('profile-list');
} else if (command === '--help') {
  process.stdout.write('fake-gah fixture\n');
  process.exit(0);
} else {
  process.stderr.write(`fake-gah fixture: unrecognized invocation: ${args.join(' ')}\n`);
  process.exit(127);
}
