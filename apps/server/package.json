{
  "name": "gah-server",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/bin.js",
  "bin": {
    "gah-server": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --watch src/bin.ts",
    "dev:mock": "tsx mock/bin.ts",
    "build": "tsc",
    "test": "node test.mjs && npm run test:mock",
    "test:mock": "tsx --test mock/*.test.ts",
    "start": "node dist/bin.js",
    "typecheck": "tsc --noEmit",
    "typecheck:mock": "tsc -p tsconfig.mock.json --noEmit",
    "register-node": "tsx src/registerNodeCli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.70.0",
    "@agentclientprotocol/codex-acp": "^1.10.0",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@effect/platform": "^0.50.0",
    "@effect/platform-node": "^0.50.0",
    "@git-agent-harness/contracts": "*",
    "@git-agent-harness/shared": "*",
    "cors": "^2.8.5",
    "effect": "^3.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.5.1",
    "web-push": "^3.6.7",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
